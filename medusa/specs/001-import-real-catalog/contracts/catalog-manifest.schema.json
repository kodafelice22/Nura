{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nura.example/schemas/catalog-manifest.schema.json",
  "title": "Nura Catalogue Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source",
    "version",
    "exportedAt",
    "approvedBy",
    "approvedAt",
    "categories",
    "collections",
    "products"
  ],
  "properties": {
    "source": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "exportedAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "type": "string", "minLength": 1, "maxLength": 255 },
    "approvedAt": { "type": "string", "format": "date-time" },
    "categories": {
      "type": "array",
      "items": { "$ref": "#/$defs/category" }
    },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/product" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "handle": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "name", "handle"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "handle": { "$ref": "#/$defs/handle" },
        "parentSourceId": {
          "oneOf": [
            { "$ref": "#/$defs/identifier" },
            { "type": "null" }
          ]
        }
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "name", "handle"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/identifier" },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 },
        "handle": { "$ref": "#/$defs/handle" }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "alt", "provenance", "primary"],
      "properties": {
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "alt": { "type": "string", "minLength": 1, "maxLength": 255 },
        "provenance": { "type": "string", "minLength": 1, "maxLength": 255 },
        "primary": { "type": "boolean" }
      }
    },
    "price": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currencyCode", "amount"],
      "properties": {
        "currencyCode": { "type": "string", "pattern": "^[a-z]{3}$" },
        "amount": { "type": "integer", "minimum": 0 }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locationCode", "quantity"],
      "properties": {
        "locationCode": { "$ref": "#/$defs/identifier" },
        "quantity": { "type": "integer", "minimum": 0 }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "sku", "title", "options", "prices", "inventory"],
      "properties": {
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sku": { "$ref": "#/$defs/identifier" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "options": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "prices": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/price" }
        },
        "inventory": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/inventory" }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "handle",
        "title",
        "description",
        "approved",
        "shippingProfileCode",
        "salesChannelCodes",
        "categorySourceIds",
        "collectionSourceIds",
        "media",
        "variants"
      ],
      "properties": {
        "sourceId": { "$ref": "#/$defs/identifier" },
        "handle": { "$ref": "#/$defs/handle" },
        "title": { "type": "string", "minLength": 1, "maxLength": 255 },
        "description": { "type": "string", "minLength": 1, "maxLength": 10000 },
        "approved": { "const": true },
        "shippingProfileCode": { "$ref": "#/$defs/identifier" },
        "salesChannelCodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "categorySourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "collectionSourceIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/identifier" }
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" }
            ]
          }
        },
        "media": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": { "$ref": "#/$defs/media" }
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": { "$ref": "#/$defs/variant" }
        }
      }
    }
  }
}
