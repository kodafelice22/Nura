# Domain names are supplied by docker-compose from the deployment environment.

import Caddyfile.common

{$STOREFRONT_DOMAIN} {
	import security_headers
	import storefront_proxy
}

www.{$STOREFRONT_DOMAIN} {
	redir https://{$STOREFRONT_DOMAIN}{uri} permanent
}

{$BACKEND_DOMAIN} {
	import security_headers
	import backend_proxy
}
