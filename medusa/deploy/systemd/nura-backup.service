[Unit]
Description=Nura encrypted PostgreSQL backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/nura/medusa
Environment=BACKUP_DIR=/var/backups/nura
Environment=BACKUP_RETENTION_DAYS=30
LoadCredential=backup-encryption-key:/etc/nura/backup-encryption-key
ExecStart=/opt/nura/medusa/scripts/backup-postgres.sh
TimeoutStartSec=30min

PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/backups/nura
NoNewPrivileges=true